extends "res://tests/iron_supply_zoom.gd"
func run() -> void:
	fresh()
	var refinery := Vector2i(20, 25)
	var turret := Vector2i(26, 25)
	game._add_building(turret, "turret", 0)
	game._add_building(refinery, "refinery", 0)
	game.tutorial.on_building_placed("refinery", refinery)
	check(game.tutorial.central_message() == "Towers can use the pink material as a booster\nConnect the refinery with a turret.", "First refinery shows its exact connection lesson")
	check(game.tutorial.pink_guide_path.is_empty() and game.tutorial.pink_lesson_target == turret, "Refinery lesson keeps its nearest target without a ghost path")
	# Connect along the lower edge of the core without passing through it.
	for x in range(22, 26): game._add_building(Vector2i(x, 26), "belt", 0)
	preload("res://scripts/pink_tutorial.gd").update(game.tutorial)
	check(game.tutorial.pink_lesson_kind == "" and game.tutorial.pink_guide_path.is_empty(), "Refinery lesson ends once its belts reach the turret footprint")
	var silo := Vector2i(20, 30)
	game._add_building(silo, "iron_store", 0)
	game.tutorial.on_building_placed("iron_store", silo)
	check(game.tutorial.pink_lesson_kind == "", "Passive silo has no fuel lesson")
	check(game.tutorial.pink_guide_path.is_empty(), "Passive silo creates no ghost path")
	for y in range(27, 30): game._add_building(Vector2i(20, y), "belt", 1)
	preload("res://scripts/pink_tutorial.gd").update(game.tutorial)
	check(game.tutorial.pink_lesson_kind == "", "Silo lesson ends when connected")
	fresh()
	game._add_building(refinery, "refinery", 0)
	game._add_building(turret, "solar", 0)
	game.tutorial.on_building_placed("refinery", refinery)
	game.tutorial.on_wave_started()
	check(game.tutorial.pink_lesson_kind == "" and game.tutorial.pink_guide_path.is_empty(), "Starting a wave dismisses the connection lesson")
	game.research("refining", true)
	game.tutorial.tech_available = true
	game.hud.show_tech_tree()
	check(game.hud.tech_buttons.has("iron_storage"), "Iron silo research appears below refining")
	game.hud.close_modal()
	# Build an authentic previous-version payload for migration.
	var legacy: Array = game.saves.snapshot().duplicate(true)
	legacy[0] = 13
	legacy[1][0].erase("pink")
	legacy[3].resize(legacy[3].size() - 3)
	for row in legacy[2]:
		row.resize(23)
		row[game.saves.BUILD_FIELDS.find("buffer") + 1].erase("pink")
	var path: String = game.saves.directory.path_join("legacy.ews")
	game.saves.write_snapshot(path, legacy)
	var restored: Array = game.saves.read_snapshot(path)
	check(not restored.is_empty() and restored[0] == game.saves.VERSION and restored[1][0].pink == 0, "Version thirteen saves gain pink material and booster/tutorial defaults")
	legacy[0] = 11
	for row in legacy[2]: row.resize(21)
	game.saves.write_snapshot(path, legacy)
	check(not game.saves.read_snapshot(path).is_empty(), "Version eleven saves migrate through shield, construction and booster formats")
	print("PINK CONNECTION LESSON CHECKS: %d passed, %d failed" % [passed, failed])
	game.free()
	quit(1 if failed else 0)
