extends "res://tests/iron_supply_zoom.gd"
func run() -> void:
	fresh()
	game.research("barriers", true)
	var wall := Vector2i(23, 25)
	var tower := Vector2i(24, 24)
	var old_wall := Vector2i(23, 26)
	game._add_building(old_wall, "wall", 0)
	check(not game.buildings[old_wall].pending, "Between-wave barriers are immediately active")
	game.enemies.assign([game.create_enemy("scout", game.cell_center(Vector2i(21, 25)), "red")])
	var drill := Vector2i(22, 26)
	var belt := Vector2i(22, 25)
	game.ores[drill] = "copper"
	game._add_building(drill, "drill", 0)
	game._add_building(belt, "belt", 0)
	game._add_building(Vector2i(26, 27), "copper_store", 0)
	check(game.buildings[drill].pending and not game.buildings[belt].pending, "Extractors are ghosts but conveyors remain active")
	game.advance_logistics(10)
	check(game.buildings[drill].progress == 0 and game.can_receive(belt, "copper"), "Ghost extractor stays idle while active conveyor accepts materials")
	check(game.material_capacity("copper") == game.base_copper_capacity, "Ghost storage provides no capacity before activation")
	check(game.place_building(wall, "wall", 0) and game.place_building(tower, "solar", 0), "Defenses can be placed during combat")
	check(game.buildings[wall].pending and game.buildings[tower].pending, "Combat placements remain ghosts")
	game.enemy_navigation.refresh_grid(game)
	check(not game.enemy_navigation.grid.is_point_solid(wall) and not game.enemy_navigation.grid.is_point_solid(tower) and game.enemy_navigation.grid.is_point_solid(old_wall), "Only active buildings block enemy movement")
	check(not game.enemy_navigation.turret_cells.has(tower), "Ghost turret contributes no danger or target priority")
	check(not game.shot_cell_blocked(wall, game.current_core), "Ghost barriers do not block shots")
	game._damage_building(wall, 1000)
	check(game.buildings.has(wall) and game.buildings[wall].hp == game.buildings[wall].max_hp, "Ghost defense cannot be damaged")
	game._update_turret(tower, game.buildings[tower], 5)
	check(game.shots.is_empty(), "Ghost turret cannot fire")
	game.saves.capture()
	check(game.saves.restore(game.saves.current) and game.buildings[wall].pending and game.buildings[tower].pending, "Save restore preserves combat ghosts")
	game.activate_pending_buildings()
	check(game.buildings[wall].pending, "Living enemies prevent activation")
	game.enemies.clear()
	game.spawn_remaining = 1
	game.activate_pending_buildings()
	check(game.buildings[wall].pending, "Queued enemies prevent premature activation")
	game.spawn_remaining = 0
	game.spawn_queue.clear()
	game.activate_pending_buildings()
	check(not game.buildings[wall].pending and not game.buildings[tower].pending, "Clearing enemies activates both barrier and turret")
	check(not game.buildings[drill].pending and not game.buildings[belt].pending and game.material_capacity("copper") == game.base_copper_capacity + 50, "Clearing enemies activates logistics and storage too")
	check(game.enemy_navigation.grid.is_point_solid(wall) and game.enemy_navigation.turret_cells.has(tower), "Activation rebuilds enemy collision and turret priorities")
	game._damage_building(wall, 5)
	check(game.buildings[wall].hp == game.buildings[wall].max_hp - 5, "Activated barrier receives normal damage")
	print("PENDING CONSTRUCTION CHECKS: %d passed, %d failed" % [passed, failed])
	game.free()
	quit(1 if failed else 0)
