extends "res://tests/iron_supply_zoom.gd"
func run() -> void:
	fresh()
	game.saves.entries.clear()
	game.saves.current = -1
	game.saves.pending_branch = false
	game.tutorial.ui_revealed.erase("wave_menu_loaded")
	game.tutorial.ui_revealed.erase("loss_saves_revealed")
	game.saves.capture()
	var drill := Vector2i(24, 25)
	game._add_building(drill, "drill", 0)
	game._damage_building(drill, 1000)
	check(game.tutorial.rewind_hint_active() and game.hud.saves_button.visible, "Extractor loss reveals and highlights wave saves before wave two")
	check(not game.hud.tutorial_prompt.text.contains("roll back time"), "Extractor loss does not add center rewind text")
	game.hud.save_browser.show_browser()
	check(not game.tutorial.rewind_hint_active(), "Clicking wave saves dismisses its glow")
	game.hud.close_modal()
	game._add_building(drill, "drill", 0)
	game._damage_building(drill, 1000)
	check(game.tutorial.rewind_hint_active(), "Another extractor loss retriggers the glow before loading")
	game.hud.save_browser.show_browser()
	game.hud.close_modal()
	game._add_building(Vector2i(24, 24), "solar", 0)
	game._add_building(Vector2i(25, 24), "solar", 0)
	game._damage_building(Vector2i(24, 24), 1000)
	check(not game.tutorial.rewind_hint_active(), "Losing a turret while another remains does not trigger")
	game._damage_building(Vector2i(25, 24), 1000)
	check(game.tutorial.rewind_hint_active(), "Losing the final turret triggers the wave saves glow")
	check(not game.hud.tutorial_prompt.text.contains("roll back time"), "Final turret loss has no center rewind text")
	game.hud.save_browser.show_browser()
	var row: HBoxContainer = game.hud.modal.get_child(0).get_child(1).get_child(0)
	row.get_child(1).pressed.emit()
	var content: Panel = game.hud.modal.get_child(0)
	for child in content.get_children():
		if child is Button and child.text == "Confirm": child.pressed.emit()
	check(game.tutorial.ui_revealed.get("wave_menu_loaded", false) and not game.tutorial.rewind_hint_active(), "Successful load through wave menu permanently completes the lesson")
	game._add_building(drill, "drill", 0)
	game._damage_building(drill, 1000)
	check(not game.tutorial.rewind_hint_active(), "Extractor loss no longer prompts after a wave-menu load")
	game._add_building(Vector2i(24, 24), "solar", 0)
	game._damage_building(Vector2i(24, 24), 1000)
	check(game.tutorial.rewind_hint_active(), "Final turret loss always prompts even after a wave-menu load")
	check(game.hud.demolish_button.position.x < game.hud.back_button.position.x and game.hud.demolish_button.get_node("Hotkey").text == "X", "Demolish button sits left of rewind with X label")
	game.hud.demolish_button.pressed.emit()
	check(game.active_tool == "abolish", "Demolish button enters demolition mode")
	game.hud.demolish_button.pressed.emit()
	check(game.active_tool != "abolish", "Demolish button toggles back out")
	print("LOSS REWIND PROMPT CHECKS: %d passed, %d failed" % [passed, failed])
	game.free()
	quit(1 if failed else 0)
